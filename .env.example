# Copie para .env e preencha (cp .env.example .env).
# O backend falha ao subir se JWT_SECRET estiver ausente ou com menos de 32 caracteres.
# Nunca commite o .env com valores reais — ele está protegido pelo .gitignore.

# Chave real da OpenAI (opcional: sem ela as funcionalidades de IA ficam indisponíveis)
OPENAI_API_KEY=

# Secret de assinatura dos tokens JWT. Gere com: openssl rand -hex 64
JWT_SECRET=

# Token do Cloudflare Tunnel (Dashboard Cloudflare Zero Trust > Tunnels > Token)
CLOUDFLARE_TUNNEL_TOKEN=